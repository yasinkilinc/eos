#!/bin/sh
# Append one event to the execution this session has open (ADR-022).
#
#   eos-event --kind ran --tool <wrapper> [--target <env|system>] [--ref <path|id>]
#             [--exit <code>] [--ms <duration>] [--body <text>]
#
# For wrappers: no interpreter, a few milliseconds, and it never fails the
# command that called it. No execution open, no session id, an unwritable
# ledger -- it exits 0 and writes nothing. That silence shows up where it
# should: as an execution with no events in `eos doctor --memory`.
#
# Which execution: EOS_EXECUTION + EOS_EXECUTION_LEDGER when the host can
# export them; otherwise the pointer `eos run start` left for this session at
# ${EOS_STATE_DIR:-~/.local/state/eos}/current/<session>, where the session id
# is EOS_SESSION, else CLAUDE_CODE_SESSION_ID (the variables telemetry reads).
#
# Refs are meant to be generated by the wrapper -- a log path, a build id. The
# credential refusal `eos run event` applies is not repeated here; a wrapper
# passing free text should use that command instead.

kind= tool= target= ref= exit_code= ms= body=
while [ $# -gt 0 ]; do
  case "$1" in
    --kind) kind=${2-}; shift 2 ;;
    --tool) tool=${2-}; shift 2 ;;
    --target) target=${2-}; shift 2 ;;
    --ref) ref=${2-}; shift 2 ;;
    --exit) exit_code=${2-}; shift 2 ;;
    --ms) ms=${2-}; shift 2 ;;
    --body) body=${2-}; shift 2 ;;
    *) shift ;;
  esac
done 2>/dev/null

case "$kind" in
  ran|read|changed|called|verified|noted|decided) ;;
  *) exit 0 ;;
esac

execution=${EOS_EXECUTION-}
ledger=${EOS_EXECUTION_LEDGER-}
session=${EOS_SESSION:-${CLAUDE_CODE_SESSION_ID-}}
if [ -z "$execution" ] || [ -z "$ledger" ]; then
  [ -n "$session" ] || exit 0
  safe=$(printf '%s' "$session" | tr -cd 'A-Za-z0-9._-' 2>/dev/null | cut -c1-64)
  [ -n "$safe" ] || exit 0
  pointer="${EOS_STATE_DIR:-$HOME/.local/state/eos}/current/$safe"
  [ -r "$pointer" ] || exit 0
  IFS='	' read -r execution ledger < "$pointer" 2>/dev/null || exit 0
  [ -n "$execution" ] && [ -n "$ledger" ] || exit 0
fi

# JSON string or null. Backslash and quote escaped, control characters dropped:
# a ref is one line, and a line break inside one would split the record.
str() {
  if [ -z "$1" ]; then printf 'null'; return; fi
  printf '"%s"' "$(printf '%s' "$1" | tr -d '\000-\037' | sed 's/\\/\\\\/g; s/"/\\"/g')"
}
num() {
  case "$1" in
    ''|*[!0-9-]*) printf 'null' ;;
    *) printf '%s' "$1" ;;
  esac
}

at=$(date -u +%Y-%m-%dT%H:%M:%S+00:00 2>/dev/null) || exit 0
line=$(printf '{"type": "event", "execution": %s, "ord": null, "at": %s, "kind": %s, "tool": %s, "target": %s, "ref": %s, "exit_code": %s, "ms": %s, "body": %s, "session": %s}' \
  "$(str "$execution")" "$(str "$at")" "$(str "$kind")" "$(str "$tool")" "$(str "$target")" \
  "$(str "$ref")" "$(num "$exit_code")" "$(num "$ms")" "$(str "$body")" "$(str "$session")")

{ printf '%s\n' "$line" >> "$ledger"; } 2>/dev/null
exit 0
